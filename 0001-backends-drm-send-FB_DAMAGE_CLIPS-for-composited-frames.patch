diff --git a/src/backends/drm/drm_layer.cpp b/src/backends/drm/drm_layer.cpp
index 8638df4..dac7852 100644
--- a/src/backends/drm/drm_layer.cpp
+++ b/src/backends/drm/drm_layer.cpp
@@ -99,6 +99,21 @@ DrmPlane *DrmPipelineLayer::plane() const
     return m_plane;
 }
 
+const std::optional<Region> &DrmPipelineLayer::bufferDamage() const
+{
+    return m_bufferDamage;
+}
+
+void DrmPipelineLayer::addBufferDamage(const Region &damage)
+{
+    m_bufferDamage = m_bufferDamage ? m_bufferDamage->united(damage) : damage;
+}
+
+void DrmPipelineLayer::bufferDamageSubmitted()
+{
+    m_bufferDamage.reset();
+}
+
 DrmPipeline *DrmPipelineLayer::pipeline() const
 {
     return drmOutput()->pipeline();
