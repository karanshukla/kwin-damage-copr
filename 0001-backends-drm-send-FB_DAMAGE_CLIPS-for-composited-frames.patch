     std::optional<std::chrono::nanoseconds> m_allowedVrrDelay;
     std::unordered_map<const DrmProperty *, std::shared_ptr<DrmBlob>> m_blobs;
     std::unordered_map<DrmPlane *, std::shared_ptr<DrmFramebuffer>> m_buffers;
+    std::unordered_map<DrmPlane *, Region> m_damage;
     std::unordered_map<DrmPlane *, std::shared_ptr<OutputFrame>> m_frames;
     std::unordered_set<DrmPlane *> m_planes;
     std::optional<bool> m_vrr;
diff --git a/src/backends/drm/drm_egl_layer.cpp b/src/backends/drm/drm_egl_layer.cpp
index 2bdaea1..b9ecda5 100644
--- a/src/backends/drm/drm_egl_layer.cpp
+++ b/src/backends/drm/drm_egl_layer.cpp
@@ -71,7 +71,15 @@ std::optional<OutputLayerBeginFrameInfo> EglGbmLayer::beginFrame(OutputFrame *fr
 
 bool EglGbmLayer::endFrame(const Region &renderedDeviceRegion, const Region &damagedDeviceRegion, OutputFrame *frame)
 {
-    return m_surface.endRendering(damagedDeviceRegion, frame);
+    const bool ret = m_surface.endRendering(damagedDeviceRegion, frame);
+    if (ret) {
+        // damagedDeviceRegion is what changed compared to the previous frame. It is only
+        // handed to the kernel for the case where device and buffer coordinates are the same,
+        // see DrmPipeline::prepareAtomicPlane
+        addBufferDamage(m_afterScanout ? Region::infinite() : damagedDeviceRegion);
+        m_afterScanout = false;
+    }
+    return ret;
 }
 
 bool EglGbmLayer::preparePresentationTest()
@@ -149,6 +157,9 @@ bool EglGbmLayer::importScanoutBuffer(GraphicsBuffer *buffer, const std::shared_
     m_scanoutBuffer = gpu()->importBuffer(buffer, FileDescriptor{});
     if (m_scanoutBuffer) {
         m_surface.forgetDamage(); // TODO: Use absolute frame sequence numbers for indexing the DamageJournal. It's more flexible and less error-prone
+        // nothing is known about how the client buffer differs from the previous one
+        addBufferDamage(Region::infinite());
+        m_afterScanout = true;
     }
     return m_scanoutBuffer != nullptr;
 }
