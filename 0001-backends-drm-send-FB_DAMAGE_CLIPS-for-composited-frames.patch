 src/backends/drm/drm_commit.h      |  9 +++++
 src/backends/drm/drm_egl_layer.cpp | 13 ++++++-
 src/backends/drm/drm_egl_layer.h   |  2 +
 src/backends/drm/drm_layer.cpp     | 15 ++++++++
 src/backends/drm/drm_layer.h       | 18 +++++++++
 src/backends/drm/drm_pipeline.cpp  | 14 +++++++
 7 files changed, 130 insertions(+), 1 deletion(-)

diff --git a/src/backends/drm/drm_commit.cpp b/src/backends/drm/drm_commit.cpp
index f3df10a..f9a63a7 100644
--- a/src/backends/drm/drm_commit.cpp
+++ b/src/backends/drm/drm_commit.cpp
@@ -139,6 +139,49 @@ void DrmAtomicCommit::addBuffer(DrmPlane *plane, const std::shared_ptr<DrmFrameb
     }
 }
 
+void DrmAtomicCommit::addDamage(DrmPlane *plane, const Region &bufferDamage)
+{
+    m_damage[plane] = bufferDamage;
+}
+
+void DrmAtomicCommit::applyDamage()
+{
+    // the kernel takes the property as is, so rebuild it every time
+    for (const auto &[plane, damage] : m_damage) {
+        const auto buffer = m_buffers.find(plane);
+        if (!plane->fbDamage.isValid() || buffer == m_buffers.end() || !buffer->second) {
+            continue;
+        }
+        const Rect bufferRect(QPoint(), buffer->second->buffer()->size());
+        const Region clipped = damage.intersected(bufferRect);
+        if (clipped.isEmpty() || (clipped.rects().size() == 1 && clipped.boundingRect() == bufferRect)) {
+            // nothing usable, or everything: the same as no clips
+            addProperty(plane->fbDamage, 0);
+            m_blobs.erase(&plane->fbDamage);
+            continue;
+        }
+        // many small rects cost more to hand over than they save
+        static constexpr qsizetype maxRects = 32;
+        QList<drm_mode_rect> data;
+        if (clipped.rects().size() > maxRects) {
+            const Rect bounds = clipped.boundingRect();
+            data.push_back(drm_mode_rect{.x1 = bounds.left(), .y1 = bounds.top(), .x2 = bounds.right(), .y2 = bounds.bottom()});
+        } else {
+            data.reserve(clipped.rects().size());
+            for (const Rect &rect : clipped.rects()) {
+                // x2 and y2 are exclusive in drm_mode_rect, like in Rect
+                data.push_back(drm_mode_rect{.x1 = rect.left(), .y1 = rect.top(), .x2 = rect.right(), .y2 = rect.bottom()});
+            }
+        }
+        if (const auto blob = DrmBlob::create(plane->gpu(), data.data(), data.size() * sizeof(drm_mode_rect))) {
+            addBlob(plane->fbDamage, blob);
+        } else {
+            addProperty(plane->fbDamage, 0);
+            m_blobs.erase(&plane->fbDamage);
+        }
+    }
+}
+
 void DrmAtomicCommit::setVrr(DrmCrtc *crtc, bool vrr)
 {
     addProperty(crtc->vrrEnabled, vrr ? 1 : 0);
@@ -184,6 +227,7 @@ std::expected<void, OutputError> DrmAtomicCommit::commitModeset()
 
 std::expected<void, OutputError> DrmAtomicCommit::doCommit(uint32_t flags)
 {
+    applyDamage();
     std::vector<uint32_t> objects;
     std::vector<uint32_t> propertyCounts;
     std::vector<uint32_t> propertyIds;
@@ -286,6 +330,22 @@ void DrmAtomicCommit::merge(DrmAtomicCommit *onTop)
         }
     }
     for (const auto &[plane, buffer] : onTop->m_buffers) {
+        // the display never sees the buffer of this commit if onTop replaces it, so
+        // what changed in either of them has to be sent. If one of them has no
+        // damage information, the whole plane has to be assumed to have changed
+        const auto onTopDamage = onTop->m_damage.find(plane);
+        const auto ownDamage = m_damage.find(plane);
+        if (!m_buffers.contains(plane)) {
+            if (onTopDamage != onTop->m_damage.end()) {
+                m_damage[plane] = onTopDamage->second;
+            } else {
+                m_damage.erase(plane);
+            }
+        } else if (ownDamage != m_damage.end() && onTopDamage != onTop->m_damage.end()) {
+            ownDamage->second = ownDamage->second.united(onTopDamage->second);
+        } else {
+            m_damage.erase(plane);
+        }
         m_buffers[plane] = buffer;
         m_frames[plane] = onTop->m_frames[plane];
         m_planes.emplace(plane);
