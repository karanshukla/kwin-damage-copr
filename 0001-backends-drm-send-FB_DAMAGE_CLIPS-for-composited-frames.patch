 #include <memory>
@@ -45,12 +46,29 @@ public:
 
     DrmPlane *plane() const;
 
+    /**
+     * The damage of the buffer that is about to be presented, relative to the buffer that was
+     * last submitted to the kernel, in buffer coordinates. std::nullopt means it is not known,
+     * in which case the kernel has to assume the whole buffer changed.
+     */
+    const std::optional<Region> &bufferDamage() const;
+    /**
+     * Adds to the buffer damage. Damage that was never submitted (rendered, but replaced
+     * before it was presented) stays and accumulates, so nothing the display missed gets lost.
+     */
+    void addBufferDamage(const Region &damage);
+    /**
+     * To be called once the damage was handed to the kernel with a commit
+     */
+    void bufferDamageSubmitted();
+
 protected:
     DrmPipeline *pipeline() const;
     DrmGpu *gpu() const;
     DrmOutput *drmOutput() const;
 
     DrmPlane *m_plane = nullptr;
+    std::optional<Region> m_bufferDamage;
 };
 
 }
